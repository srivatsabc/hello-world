  "steps": {
    "conventional": [
      "You click Add, Subtract or Get weather.",
      "The frontend calls a FastAPI endpoint (calculation-management for add and subtract, weather-management for weather).",
      "The endpoint hands the work to a service.",
      "For weather, the service fetches live data from Open-Meteo.",
      "The result flows back and is shown on the page."
    ],
    "ai": [
      "You type plain English and hit Ask.",
      "The frontend calls one API: agent-management.",
      "The LangChain agent asks the model (Azure OpenAI) which tool to use.",
      "The agent calls a tool. Tools are its hands and legs, declared inside the agent but able to call internal code, an external API or an MCP server.",
      "Here the tools call the same services the normal APIs use (weather goes on to Open-Meteo). That layer could just as well be an MCP layer.",
      "The answer returns, with the tool used shown under intermediate_results."
    ]
  },
  "flow_titles": {
    "conventional": "Conventional: direct API calls",
    "ai": "AI: agent with tools"
  }
}
